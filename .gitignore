# Downloaded or generated data. Keep only small, safe demo/evaluation inputs.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/home_credit/*
!data/home_credit/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
!data/synthetic/simulator_behaviour_features.csv
external/

# Generated model artefacts. The selected demo model is intentionally versioned
# so that the validation dashboard works after cloning.
models/*
!models/home_credit_lightgbm.joblib
!models/transaction_nlp_pipeline.joblib
!models/behavioral_unsupervised_bundle.joblib
!models/behavioral_prediction_model.joblib

# Version only the small, presentation-ready evaluation artefacts.
reports/*
!reports/category_rule_evaluation.json
!reports/home_credit_calibration.json
!reports/home_credit_global_importance.json
!reports/home_credit_metrics.json
!reports/home_credit_model_comparison.json
