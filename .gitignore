!reports/affordability_policy_evaluation.json
!reports/heldout_category_rule_evaluation.json
!reports/uci_metrics.json
!reports/transaction_nlp_metrics.json
!reports/behavioral_unsupervised_metrics.json
!reports/behavioral_prediction_metrics.json
!reports/figures/
!reports/figures/*

